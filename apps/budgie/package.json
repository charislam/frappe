{
  "name": "@charismaticalli/budgie",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "fmt": "oxfmt",
    "lint": "oxlint src database-tests && oxfmt --check src database-tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:database": "supabase test db",
    "test:database:concurrency": "node --experimental-strip-types database-tests/concurrency.test.ts",
    "test:database:lint": "supabase db lint --schema public,budgie_private --level warning --fail-on warning",
    "db:sync": "supabase db schema declarative sync --no-apply --strict-coverage"
  },
  "dependencies": {
    "@charismaticalli/frappe": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
