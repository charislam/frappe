{
  "name": "@charismaticalli/skate",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:budgie && pnpm dev:site",
    "dev:budgie": "pnpm --filter @charismaticalli/budgie dev",
    "dev:site": "pnpm --filter @charismaticalli/site dev",
	"build": "pnpm build:budgie && pnpm build:site",
    "build:budgie": "pnpm --filter @charismaticalli/budgie build",
    "build:site": "pnpm --filter @charismaticalli/site build",
    "fmt": "pnpm fmt:frappe && pnpm fmt:ui && pnpm fmt:site && pnpm fmt:budgie",
    "fmt:budgie": "pnpm --filter @charismaticalli/budgie fmt",
    "fmt:frappe": "pnpm --filter @charismaticalli/frappe fmt",
    "fmt:ui": "pnpm --filter @charismaticalli/ui fmt",
    "fmt:site": "pnpm --filter @charismaticalli/site fmt",
    "lint": "pnpm lint:frappe && pnpm lint:ui && pnpm lint:site && pnpm lint:budgie",
    "lint:budgie": "pnpm --filter @charismaticalli/budgie lint",
    "lint:frappe": "pnpm --filter @charismaticalli/frappe lint",
    "lint:ui": "pnpm --filter @charismaticalli/ui lint",
    "lint:site": "pnpm --filter @charismaticalli/site lint",
    "test": "pnpm test:frappe && pnpm test:ui && pnpm test:site && pnpm test:budgie",
    "test:budgie": "pnpm --filter @charismaticalli/budgie test",
    "test:frappe": "pnpm --filter @charismaticalli/frappe test",
    "test:ui": "pnpm --filter @charismaticalli/ui test",
    "test:site": "pnpm --filter @charismaticalli/site test",
    "typecheck": "pnpm typecheck:frappe && pnpm typecheck:ui && pnpm typecheck:site && pnpm typecheck:budgie",
    "typecheck:budgie": "pnpm --filter @charismaticalli/budgie typecheck",
    "typecheck:frappe": "pnpm --filter @charismaticalli/frappe typecheck",
    "typecheck:ui": "pnpm --filter @charismaticalli/ui typecheck",
    "typecheck:site": "pnpm --filter @charismaticalli/site typecheck"
  },
  "packageManager": "pnpm@11.27.1+sha512.a81d4c21b9b09a4b0aebf90ef5e527d4262bdda322d26082978cb549023ac6d9cafc98b19fffaa5c71db438a65f70224edb78d7311187861ff96480d1cdca23c",
  "devDependencies": {
    "supabase": "^2.120.0"
  }
}
